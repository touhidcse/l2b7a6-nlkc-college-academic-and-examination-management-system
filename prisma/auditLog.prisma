// ==================================================
// AUDIT LOG
// ==================================================

model AuditLog {
  id       String    @id @default(uuid())

  userId String?

  action String

  entity String

  entityId String?

  oldData Json?

  newData Json?

  ipAddress String?

  userAgent String?

  user User? @relation( fields: [userId], references: [id])

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([entity, entityId])
  @@index([action])
  @@index([createdAt])

  @@map("audit_logs")
}